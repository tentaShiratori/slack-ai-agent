# ローカル用。コピーして .env にする: copy .env.example .env
# 秘密は git に入れない。mise.toml のプレースホルダよりこちらを使うときは
# シェルで読み込むか、mise の env を上書きする。

WORKER_SECRET=dev-secret
SLACK_BOT_TOKEN=xoxb-replace-me
REDIS_URL=redis://127.0.0.1:6379
WORKER_URL=http://127.0.0.1:8080
SKIP_SLACK_VERIFY=1

# fine-grained PAT。Issues / Discussions と Project の read/write
GITHUB_PAT=github_pat_replace_me
GITHUB_DEFAULT_REPO=owner/repo
GITHUB_PROJECT_ID=PVT_replace_me
GITHUB_DISCUSSION_CATEGORY_ID=DIC_replace_me
# GITHUB_DISCUSSION_REPO=owner/other
