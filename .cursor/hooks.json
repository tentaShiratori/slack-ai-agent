{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "node .cursor/hooks/crg-update.ts",
        "timeout": 30
      }
    ],
    "sessionStart": [
      {
        "command": "node .cursor/hooks/crg-session-start.ts",
        "timeout": 20
      },
      {
        "command": "node .cursor/hooks/memory-session-start.ts",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/format.ts",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop.ts",
        "timeout": 300,
        "loop_limit": 3
      }
    ]
  }
}